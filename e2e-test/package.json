		"@types/eslint__js": "8.42.3",
		"@types/node": "24.9.2",
		"@typescript-eslint/eslint-plugin": "8.46.2",
		"@typescript-eslint/parser": "8.46.2",
		"eslint": "9.38.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-playwright": "2.2.2",
		"globals": "16.4.0",
		"npm-run-all2": "8.0.4",
		"prettier": "3.6.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.46.2"
	}
}
