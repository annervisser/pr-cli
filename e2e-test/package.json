		"@types/eslint__js": "8.42.3",
		"@types/node": "22.13.5",
		"@typescript-eslint/eslint-plugin": "8.24.1",
		"@typescript-eslint/parser": "8.24.1",
		"eslint": "9.21.0",
		"eslint-config-prettier": "10.0.1",
		"eslint-plugin-playwright": "2.2.0",
		"globals": "15.15.0",
		"npm-run-all2": "7.0.2",
		"prettier": "3.5.2",
		"typescript": "5.7.3",
		"typescript-eslint": "8.24.1"
	}
}
